# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key -- server-side ONLY, never expose this to the frontend.
# It bypasses Row Level Security, which is why the Express backend (not the
# browser) is the only thing that should hold it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port the Express API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173
