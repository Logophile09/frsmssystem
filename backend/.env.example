# Supabase project settings (Project Settings -> API in the Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Service role key -- server-side ONLY, never expose this to the frontend.
# It bypasses Row Level Security, which is why the Express backend (not the
# browser) is the only thing that should hold it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Port the Express API listens on
PORT=4000

# Comma-separated list of origins allowed to call this API (your frontend URL)
CORS_ORIGIN=http://localhost:5173

# Groq API key -- powers the AI-assist endpoints in src/routes/ai.ts
# (Groq-narrated decision-tree analysis on the Dispatch Recommendation
# page, and drafted incident summaries on the Incidents page). Both
# features are optional: if this is unset, those two "AI" buttons show a
# clear error and everything else in the system works exactly the same,
# since the decision tree and false-alarm scoring are separate,
# deterministic code paths that never call this API.
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key

# Optional: override the Groq-hosted model used for AI-assist (defaults to
# llama-3.3-70b-versatile in src/lib/groqClient.ts if unset).
# GROQ_MODEL=llama-3.3-70b-versatile

# Set automatically by Vercel in production -- leave unset for local dev.
# See ../vercel.json / ../api/[...all].ts: it tells server.ts not to call
# app.listen() when running as a Vercel serverless function.
# VERCEL=1
