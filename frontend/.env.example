# Supabase project settings (Project Settings -> API in the Supabase dashboard)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where the Express API is reachable.
# - Local dev (frontend and backend run as two separate processes): the
#   standalone Express server's URL, e.g. http://localhost:4000/api
# - Production on Vercel (single monolithic deployment, see ../vercel.json):
#   use the relative path /api -- the same Vercel project serves both the
#   static frontend and the backend as one unit, so there's no separate host.
VITE_API_URL=http://localhost:4000/api
