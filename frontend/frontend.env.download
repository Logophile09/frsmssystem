# Copy this file to frontend/.env.local (note: it must be named exactly ".env.local")
#
# Get the first two from your Supabase project:
# Supabase Dashboard -> Project Settings -> API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Where your Express backend is reachable.
# Local dev (matches your backend/.env PORT):
VITE_API_URL=http://localhost:4000/api

# If your backend is deployed (Render/Railway/Fly.io), use that instead, e.g.:
# VITE_API_URL=https://frsms-api.onrender.com/api
